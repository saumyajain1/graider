DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
FRONTEND_URL=http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
APP_TIME_ZONE=America/Vancouver

# Neon Object Storage: copy the branch-scoped values from Neon when enabling uploads.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=uploads

GRAIDER_MAX_UPLOAD_BYTES=10485760
GRAIDER_MAX_PDF_PAGES=30
GRAIDER_MAX_ASSIGNMENT_CHARS=100000
GRAIDER_MAX_RESPONSE_CHARS=50000
GRAIDER_MAX_CSV_BYTES=2097152
GRAIDER_MAX_CSV_ROWS=100
GRAIDER_MAX_SUBMISSIONS_PER_ASSIGNMENT=100
GRAIDER_LOGIN_RATE=10/min
GRAIDER_REGISTER_RATE=5/hour
GRAIDER_AUTH_CHECK_RATE=120/min

# Production: set DJANGO_DEBUG=false and supply a real DJANGO_SECRET_KEY,
# DJANGO_ALLOWED_HOSTS, and a Neon PostgreSQL DATABASE_URL in Render.
# For the same-origin production site, leave FRONTEND_URL and both origin lists empty.
# Add quota settings when quota enforcement is introduced.

OPENAI_API_KEY=replace-me
OPENAI_QUESTION_MODEL=gpt-5.4-mini
OPENAI_ARTIFACT_MODEL=gpt-5.4-mini
OPENAI_MAPPING_MODEL=gpt-5.4-mini
OPENAI_GRADING_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
