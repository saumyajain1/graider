# Django
DJANGO_DEBUG="true" # Local development only; use false in production.
DJANGO_SECRET_KEY="replace-with-a-long-random-local-secret" # Signs sessions and reset links; keep private and unique.
DJANGO_ALLOWED_HOSTS="127.0.0.1,localhost" # Hostnames Django accepts, without schemes or ports.
APP_TIME_ZONE="America/Vancouver" # Timezone used when displaying dates and times.

# Docker Compose image tag: latest release, or sha-<commit> for an exact version.
GRAIDER_IMAGE_TAG="latest" # Docker Hub release tag used by Compose.

# Database: leave empty for local SQLite; use Neon PostgreSQL in production.
DATABASE_URL="" # Empty uses local SQLite; production requires a PostgreSQL URL.

# Frontend and allowed origins
FRONTEND_URL="http://localhost:5173" # Separate frontend origin for redirects; empty for one shared origin.
DJANGO_CORS_ALLOWED_ORIGINS="http://localhost:5173" # Origins permitted to call the API from browsers.
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost:5173" # Separate origins trusted for authenticated form requests.

# Neon Object Storage: use credentials from the same branch as the database.
AWS_ENDPOINT_URL_S3="" # Neon Object Storage endpoint; AWS naming comes from its S3-compatible client.
AWS_ACCESS_KEY_ID="" # Neon storage access key, not an AWS account credential.
AWS_SECRET_ACCESS_KEY="" # Neon storage secret key; keep private.
AWS_REGION="us-east-2" # Region used to sign Neon storage requests.
NEON_STORAGE_BUCKET="uploads" # Private bucket holding assignments and student uploads.

# Upload and import limits
GRAIDER_MAX_UPLOAD_BYTES="10485760" # Maximum size of one uploaded file, in bytes (10 MiB).
GRAIDER_MAX_PDF_PAGES="30" # Maximum pages extracted from one uploaded PDF.
GRAIDER_MAX_ASSIGNMENT_CHARS="100000" # Maximum characters in assignment source text.
GRAIDER_MAX_RESPONSE_CHARS="50000" # Maximum characters in one student response.
GRAIDER_MAX_CSV_BYTES="2097152" # Maximum CSV import size, in bytes (2 MiB).
GRAIDER_MAX_CSV_ROWS="100" # Maximum student rows accepted in one CSV import.
GRAIDER_MAX_SUBMISSIONS_PER_ASSIGNMENT="100" # Maximum stored submissions for one assignment.

# Authentication rate limits
GRAIDER_LOGIN_RATE="10/min" # Password sign-in attempts per IP address.
GRAIDER_REGISTER_RATE="5/hour" # Password registration attempts per IP address.
GRAIDER_AUTH_CHECK_RATE="120/min" # Session checks per IP address.
GRAIDER_GOOGLE_RATE="10/min" # Google sign-in or account-connection starts per IP address.

# Password recovery: HTTPS delivery on Render; local development prints reset links.
BREVO_API_KEY="" # HTTPS email delivery credential; empty locally prints reset links.
GRAIDER_FROM_EMAIL="" # Verified email sender for password reset messages.
GRAIDER_PASSWORD_RESET_RATE="5/hour" # Password reset requests per IP address.
GRAIDER_ACCOUNT_RATE="10/min" # Account management requests per IP address.

# Google sign-in/signup: both credentials are required to enable it.
# Register /accounts/google/login/callback/ on your local and production origins.
GOOGLE_CLIENT_ID="" # OAuth client registered for this local or production origin.
GOOGLE_CLIENT_SECRET="" # Secret for that Google OAuth client; keep private.

# OpenAI credentials and request timeout
OPENAI_API_KEY=""
OPENAI_TIMEOUT_SECONDS="60" # Timeout for one provider request, in seconds.

# AI models
OPENAI_QUESTION_MODEL="gpt-6-luna" # Question extraction and repair model.
OPENAI_ARTIFACT_MODEL="gpt-6-luna" # Model shared by reference answers and rubric generation.
OPENAI_MAPPING_MODEL="gpt-6-luna" # Matches student response text to assignment questions.
OPENAI_GRADING_MODEL="gpt-6-luna" # Generates scores and feedback against the rubric.

# AI reasoning: none, low, medium, high, xhigh, or max.
# Medium for math and grading decisions; low for matching and small repairs.
OPENAI_QUESTION_REASONING_EFFORT="medium" # Reasoning effort for question extraction.
OPENAI_QUESTION_REPAIR_REASONING_EFFORT="low" # Reasoning effort for correcting extracted question structure.
OPENAI_REFERENCE_REASONING_EFFORT="medium" # Reasoning effort for reference answer generation.
OPENAI_RUBRIC_REASONING_EFFORT="medium" # Reasoning effort for rubric generation.
OPENAI_MAPPING_REASONING_EFFORT="low" # Reasoning effort for matching answers to questions.
OPENAI_GRADING_REASONING_EFFORT="medium" # Reasoning effort for scoring and feedback.

# AI usage limits
GRAIDER_USER_DAILY_TOKENS="250000" # Combined input/output token allowance per teacher per day.
GRAIDER_USER_MONTHLY_TOKENS="500000" # Combined input/output token allowance per teacher per month.
GRAIDER_GLOBAL_MONTHLY_TOKENS="2000000" # Monthly token allowance shared by all teachers.
GRAIDER_USER_AI_REQUESTS_PER_MINUTE="40" # Provider request starts allowed per teacher per minute.
GRAIDER_MAX_OUTPUT_TOKENS="8192" # Maximum output tokens reserved for one AI request.

# Background AI jobs: disable to pause admission and execution for maintenance.
# Paused/attention-required jobs count toward capacity; batch parents do not.
GRAIDER_AI_METRICS="false" # Log numeric AI timings and container resource samples; no prompts or answers.
GRAIDER_AI_JOBS_ENABLED="true" # Run the worker and accept AI jobs; false pauses AI without a synchronous fallback.
GRAIDER_AI_CONCURRENCY="3" # Maximum simultaneous AI calls across all jobs.
GRAIDER_AI_STUDENT_CONCURRENCY="3" # Students in the rolling grading window; the global call cap still applies.
GRAIDER_AI_LEASE_SECONDS="90" # Seconds before an abandoned claim is recoverable; must exceed three heartbeat intervals.
GRAIDER_AI_HEARTBEAT_SECONDS="10" # Seconds between renewals of running claims; must be less than one-third of the lease.
GRAIDER_AI_SCAN_SECONDS="2" # Seconds between queue scans while work is active; no database scanning while idle.
GRAIDER_AI_FAIRNESS_SECONDS="30" # Seconds waiting before a job is promoted to prevent starvation.
GRAIDER_AI_SAFE_RETRIES="2" # Automatic retries for known-safe rejections; 0 disables them. Uncertain charges need explicit retry.
GRAIDER_AI_RETRY_SECONDS="10" # Initial safe-retry delay in seconds; subsequent retries use exponential backoff.
GRAIDER_AI_DRAIN_SECONDS="20" # Seconds allowed for in-flight work to finish during shutdown.
GRAIDER_AI_WAKE_SOCKET="/tmp/graider-ai-worker.sock" # Private local notification socket; web and worker must use the same path.
GRAIDER_AI_USER_QUEUE_LIMIT="20" # Unfinished jobs per teacher; includes paused jobs, excludes batch parents.
GRAIDER_AI_GLOBAL_QUEUE_LIMIT="50" # Unfinished jobs across all teachers; same counting rules.
GRAIDER_AI_MAX_BATCH_SUBMISSIONS="10" # Maximum students accepted in one background grading batch.
GRAIDER_AI_MAX_GRADING_QUESTIONS="10" # Maximum scored questions per background-graded submission.

# Production server: Gunicorn handles HTTP; a separate process runs AI jobs.
PORT="10000" # HTTP port inside the container; Render may supply this.
GUNICORN_WORKERS="1" # Web server processes; each process adds memory use.
GUNICORN_THREADS="4" # Concurrent web request threads per process.
GUNICORN_TIMEOUT_SECONDS="120" # Restart a web worker silent for this many seconds, not a per-request timeout.
GUNICORN_GRACEFUL_TIMEOUT_SECONDS="120" # Seconds allowed for web requests to finish during shutdown.

# Production: set DJANGO_DEBUG=false and supply a real DJANGO_SECRET_KEY
# and Neon PostgreSQL DATABASE_URL. Render supplies its hostname automatically;
# add any custom domains to DJANGO_ALLOWED_HOSTS.
# For the same-origin production site, leave FRONTEND_URL and both origin lists empty.
# Set OpenAI's enforced project hard spend limit in the API Platform before going public.
