# Django
DJANGO_DEBUG="true"
DJANGO_SECRET_KEY="replace-with-a-long-random-local-secret"
DJANGO_ALLOWED_HOSTS="127.0.0.1,localhost"
APP_TIME_ZONE="America/Vancouver"

# Database: leave empty for local SQLite; use Neon PostgreSQL in production.
DATABASE_URL=""

# Frontend and allowed origins
FRONTEND_URL="http://localhost:5173"
DJANGO_CORS_ALLOWED_ORIGINS="http://localhost:5173"
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost:5173"

# Neon Object Storage: use credentials from the same branch as the database.
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
NEON_STORAGE_BUCKET="uploads"

# Upload and import limits
GRAIDER_MAX_UPLOAD_BYTES="10485760"
GRAIDER_MAX_PDF_PAGES="30"
GRAIDER_MAX_ASSIGNMENT_CHARS="100000"
GRAIDER_MAX_RESPONSE_CHARS="50000"
GRAIDER_MAX_CSV_BYTES="2097152"
GRAIDER_MAX_CSV_ROWS="100"
GRAIDER_MAX_SUBMISSIONS_PER_ASSIGNMENT="100"

# Authentication rate limits
GRAIDER_LOGIN_RATE="10/min"
GRAIDER_REGISTER_RATE="5/hour"
GRAIDER_AUTH_CHECK_RATE="120/min"

# OpenAI credentials and request timeout
OPENAI_API_KEY=""
OPENAI_TIMEOUT_SECONDS="60"

# AI models
OPENAI_QUESTION_MODEL="gpt-6-luna"
OPENAI_ARTIFACT_MODEL="gpt-6-luna"
OPENAI_MAPPING_MODEL="gpt-6-luna"
OPENAI_GRADING_MODEL="gpt-6-luna"

# AI reasoning: none, low, medium, high, xhigh, or max.
# Medium for math and grading decisions; low for matching and small repairs.
OPENAI_QUESTION_REASONING_EFFORT="medium"
OPENAI_QUESTION_REPAIR_REASONING_EFFORT="low"
OPENAI_REFERENCE_REASONING_EFFORT="medium"
OPENAI_RUBRIC_REASONING_EFFORT="medium"
OPENAI_MAPPING_REASONING_EFFORT="low"
OPENAI_GRADING_REASONING_EFFORT="medium"

# AI usage limits
GRAIDER_USER_DAILY_TOKENS="250000"
GRAIDER_USER_MONTHLY_TOKENS="500000"
GRAIDER_GLOBAL_MONTHLY_TOKENS="2000000"
GRAIDER_USER_AI_REQUESTS_PER_MINUTE="40"
GRAIDER_MAX_OUTPUT_TOKENS="8192"

# Bulk grading and repeat requests
GRAIDER_MAX_GRADE_ALL_SUBMISSIONS="5"
GRAIDER_MAX_GRADE_ALL_QUESTIONS="5"
GRAIDER_GRADE_REPEAT_COOLDOWN_SECONDS="120"

# Production server: Gunicorn uses threaded workers for synchronous AI requests.
PORT="10000"
GUNICORN_WORKERS="1"
GUNICORN_THREADS="4"
GUNICORN_TIMEOUT_SECONDS="120"
GUNICORN_GRACEFUL_TIMEOUT_SECONDS="120"

# Production: set DJANGO_DEBUG=false and supply a real DJANGO_SECRET_KEY
# and Neon PostgreSQL DATABASE_URL. Render supplies its hostname automatically;
# add any custom domains to DJANGO_ALLOWED_HOSTS.
# For the same-origin production site, leave FRONTEND_URL and both origin lists empty.
# Set OpenAI's enforced project hard spend limit in the API Platform before going public.
